# Port the API listens on
PORT=3000

# MongoDB connection string (local MongoDB or a free MongoDB Atlas cluster)
DATABASE_URL=mongodb://127.0.0.1:27017/techbuddy

# Secret used to sign login tokens. Use any long random string.
JWT_PASSWORD=change-me-to-a-long-random-string

# Frontend URL(s) allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:5173

# Set to "production" when deployed (enables secure cross-site cookies)
NODE_ENV=development
